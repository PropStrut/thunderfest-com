
!include <ntwin32.mak>

CgiPath=D:\HTML\CGI-UTIL

ALL: NEWSBITS.EXE

NEWSBITS.OBJ: NEWSBITS.C
    $(cc) -DSTRICT -I$(CgiPath) $(cflags) $(cvars) NEWSBITS.C

NEWSBITS.EXE: NEWSBITS.OBJ D:\HTML\CGI-UTIL\CGI-UTIL.OBJ
  $(link) $(conflags) NEWSBITS.OBJ D:\HTML\CGI-UTIL\CGI-UTIL.OBJ user32.lib $(conlibs)

