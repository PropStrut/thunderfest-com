
!include <ntwin32.mak>

CgiPath=\HTML\CGI\CGI-UTIL


ALL: LOCALSND.EXE


LOCALSND.OBJ: LOCALSND.C list.h
    $(cc) -DSTRICT -I$(CgiPath) $(cflags) $(cvars) LOCALSND.C

LOCALSND.EXE: LOCALSND.OBJ \HTML\CGI\CGI-UTIL\CGI-UTIL.OBJ
  $(link) $(conflags) LOCALSND.OBJ \HTML\CGI\CGI-UTIL\CGI-UTIL.OBJ user32.lib $(conlibs)


